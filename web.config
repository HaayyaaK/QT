<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <system.webServer>

    <!-- =========================================================
         DEFAULT DOCUMENT — the app's entry file isn't named index.html
         ========================================================= -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="TradingDashboard.html" />
      </files>
    </defaultDocument>

    <!-- =========================================================
         STATIC MIME TYPES
         ========================================================= -->
    <staticContent>
      <remove fileExtension=".js" />
      <mimeMap fileExtension=".js" mimeType="application/javascript" />
      <remove fileExtension=".mjs" />
      <mimeMap fileExtension=".mjs" mimeType="application/javascript" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <!-- IIS serves 404.3 for extensions it has no MIME mapping for, so the
           PWA manifest and the SVG icons need registering explicitly —
           .webmanifest is not in the default IIS MIME table. -->
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <!-- Nothing in this app is content-hashed/versioned (no ?v= or
           /assets/app.abc123.js pattern), so nothing gets a long max-age —
           nothing should be cached longer than the browser needs to
           revalidate, or a deploy can leave visitors on stale JS. -->
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>

    <!-- =========================================================
         COMPRESSION
         ========================================================= -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <!-- =========================================================
         HTTP SECURITY HEADERS
         TradingDashboard.html already sets a full, carefully-scoped CSP via
         <meta http-equiv="Content-Security-Policy">  (see that file's head
         for the reasoning behind every directive — 'unsafe-eval' for the
         dc-runtime template compiler, the exact TradingView/Binance/Kraken/
         Coinbase/proxy origins, etc). Deliberately NOT duplicating a second,
         divergent CSP here — only adding upgrade-insecure-requests, which
         is safe to declare in both places and doesn't need to track this
         project's origin allowlist.
         ========================================================= -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options"  value="nosniff" />
        <add name="X-Frame-Options"         value="SAMEORIGIN" />
        <add name="Referrer-Policy"         value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy"      value="geolocation=(), microphone=(), camera=()" />
        <add name="Content-Security-Policy" value="upgrade-insecure-requests" />
      </customHeaders>
    </httpProtocol>

    <directoryBrowse enabled="false" />

    <!-- =========================================================
         REQUEST FILTERING — defense-in-depth backstop. The real secrets
         live in C:\proxy-server\.env, a separate project directory never
         copied into this site's physical path — but block the obvious
         extensions/folders anyway in case anything is ever added by
         mistake (e.g. a stray .env, this project's own .git).
         ========================================================= -->
    <security>
      <requestFiltering>
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".env"  allowed="false" />
          <add fileExtension=".ps1"  allowed="false" />
          <add fileExtension=".log"  allowed="false" />
          <add fileExtension=".bak"  allowed="false" />
          <add fileExtension=".pem"  allowed="false" />
          <add fileExtension=".key"  allowed="false" />
        </fileExtensions>
        <hiddenSegments applyToWebDAV="true">
          <add segment=".git" />
          <add segment="node_modules" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!-- =========================================================
         URL REWRITE
         ========================================================= -->
    <rewrite>
      <rules>

        <!-- ── HTTPS redirect, Cloudflare-safe ──────────────────────
             Checks X-Forwarded-Proto, not just the server variable HTTPS.
             If Cloudflare (or any proxy in front of this box) terminates
             TLS at the edge and talks to this origin over plain HTTP
             (Cloudflare's "Flexible" SSL mode), a redirect rule that only
             checks {HTTPS} would see every request as insecure and issue
             an infinite redirect loop for every visitor — the single most
             common IIS+Cloudflare misconfiguration. Excludes /api/* so
             proxied API calls (already same-origin, already whatever
             scheme the page loaded as) pass straight through. -->
        <rule name="HttpsRedirect" stopProcessing="true">
          <match url="^api/" negate="true" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{HTTP_X_FORWARDED_PROTO}" pattern="^https$" negate="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:0}" redirectType="Permanent" />
        </rule>

        <!-- ── Reverse-proxy /api/* to the local Node proxy ─────────
             Requires: (1) the URL Rewrite + Application Request Routing
             (ARR) modules installed, (2) ARR's proxy feature enabled
             server-wide (IIS Manager → server node → Application Request
             Routing Cache → Server Proxy Settings → "Enable proxy", or
             `appcmd set config -section:system.webServer/proxy
             /enabled:"True" /commit:apphost`) — neither is scoped to a
             single site, so this needs a one-time server-level step.
             The proxy (C:\proxy-server) binds 127.0.0.1 only — this rule
             is the *only* path to it from outside the machine. -->
        <rule name="ProxyApi" stopProcessing="true">
          <match url="^api/(.*)$" />
          <action type="Rewrite" url="http://127.0.0.1:8787/api/{R:1}" />
        </rule>

      </rules>

      <outboundRules>
        <preConditions>
          <preCondition name="IsAppAsset">
            <add input="{REQUEST_URI}" pattern="\.(?:html|js|json)(?:\?.*)?$" />
          </preCondition>
        </preConditions>
        <rule name="DisableAppAssetCache" preCondition="IsAppAsset">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <action type="Rewrite" value="no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" />
        </rule>
      </outboundRules>
    </rewrite>

  </system.webServer>
</configuration>
