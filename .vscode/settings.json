{
  // TradingDashboard.html uses `{{ expr }}` mustache-style template
  // placeholders inside `style="..."` attributes (e.g.
  // `style="background:{{ chip.style }}"`), resolved at runtime by the
  // dc-runtime template compiler in support.js — never by the browser's own
  // CSS parser. VS Code's built-in CSS language service doesn't know about
  // that runtime step: it eagerly validates the raw, unresolved attribute
  // text as literal CSS and chokes on the `{` `}` characters (reported as
  // "identifier expected", "} expected", "Do not use empty rulesets", etc.
  // on nearly every styled element in the file).
  //
  // These are IDE-only false positives, not real bugs — confirmed by a
  // clean `node --check` on every save and zero CSS errors in the actual
  // browser console across every test session. This repo has no standalone
  // .css files, so turning validation off here costs nothing real; it just
  // stops ~80 phantom diagnostics from a syntax this project intentionally
  // uses throughout.
  "css.validate": false
}
